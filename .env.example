# Configuration for `docker compose`. Do NOT edit by hand: run  python scripts/init_env.py
# which copies this file to .env and fills in every secret with a random value.
# Never commit .env.

# ---- shared by all services (>= 32 characters) ----
JWT_SECRET=generate-me
# ---- employee-service only: encrypts bank account numbers. BACK THIS UP: losing it makes
#      stored account numbers unreadable. (Fernet key = 32 random bytes, url-safe base64.)
BANK_ENCRYPTION_KEY=generate-me

# ---- PostgreSQL: use letters and digits only (these are placed inside connection URLs) ----
POSTGRES_PASSWORD=generate-me
AUTH_DB_PASSWORD=generate-me
EMPLOYEE_DB_PASSWORD=generate-me
LEAVE_DB_PASSWORD=generate-me
PAYROLL_DB_PASSWORD=generate-me

# ---- first administrator (created on start if the username does not exist yet) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=generate-me

# ---- monitoring (both UIs listen on 127.0.0.1 only) ----
GRAFANA_ADMIN_PASSWORD=generate-me
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# ---- printed on payslips ----
COMPANY_NAME=Your Company Name
COMPANY_ADDRESS=

# ---- public port of the gateway ----
GATEWAY_PORT=8080
LOG_LEVEL=INFO
